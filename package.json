{
  "name": "brandalbet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Secure server-side backend API for Brandalbet",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npx --yes wrangler@4.129.1 dev",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "build": "npm run build:cloudflare",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "bundle:cloudflare": "npx --yes wrangler@4.129.1 deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "npx --yes wrangler@4.129.1 deploy --yes",
    "validate": "npm run check && npm test && npm run build:cloudflare && npm run bundle:cloudflare"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {}
}
